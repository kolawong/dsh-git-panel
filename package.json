{
  "name": "@dsh-external/dsh-git-panel",
  "version": "0.0.1",
  "description": "DSH Web 左栏 Git 面板：分支/upstream/ahead-behind、变更文件列表、按文件 unified diff",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "git",
    "panel",
    "diff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kolawong/dsh-git-panel.git"
  },
  "homepage": "https://github.com/kolawong/dsh-git-panel#readme",
  "bugs": {
    "url": "https://github.com/kolawong/dsh-git-panel/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1",
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/schemastery": "^3.18.0",
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0",
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "cordis": { "optional": true },
    "schemastery": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "build:client": "tsdown",
    "build:all": "bash scripts/build.sh && npm run build:client"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
